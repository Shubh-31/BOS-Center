          <match url="^solutions/banking-financial/core-banking-software/$" />
          <action type="Redirect" url="/core-banking-software/" redirectType="Permanent"/>
        </rule>
        <!-- Home redirects with query string -->
        <rule name="HomeRedirectTrkPublicPostText" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)trk=public_post-text(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="HomeRedirectWhoisDataCenter" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)whoisdatacenter\.com(&amp;|$)" />
          </conditions>
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="HomeRedirectTrkPublicPostMainFeed" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)trk=public_post_main-feed-card-text(&amp;|$)" />
